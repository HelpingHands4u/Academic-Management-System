FIREBASE_PROJECT_ID=
# Server-only service-account values. Never use a frontend/public env prefix.
FIREBASE_CLIENT_EMAIL=
# Supports actual newlines or literal \n sequences. Never commit the real key.
FIREBASE_PRIVATE_KEY=
# HTTP(S) origin only, e.g. http://localhost:5500 (comma-separated origins supported).
FRONTEND_URL=
# Reserved for future server-side use; no chatbot module is enabled.
GROQ_API_KEY=
SESSION_ACTIVE_WINDOW_SECONDS=300
SESSION_RECENT_WINDOW_SECONDS=86400
